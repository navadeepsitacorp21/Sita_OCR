# Environment Variables Template for Render
# ─────────────────────────────────────────
# Copy these into the Render Dashboard > Environment for each service.
# Do NOT commit real values to git.

# ── sita-ocr-backend (Web Service) ───────────────────────────────────────────
ENV=production
DEBUG=false
OCR_PROVIDER=rapidocr
OCR_ENABLE_FALLBACK=false
OCR_TIMEOUT_SECONDS=60
# Database URL:
# For Supabase (Recommended for Free Tier - no disk needed):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For Local Persistent Disk SQLite:
# DATABASE_URL=sqlite:////data/health_vault.db
DATABASE_URL=

# Set ALLOWED_ORIGINS after the frontend is deployed.
# Comma-separated list of allowed frontend origins.
# Example:
# ALLOWED_ORIGINS=https://sita-ocr-frontend.onrender.com,https://your-custom-domain.com
ALLOWED_ORIGINS=

# ── sita-ocr-frontend (Static Site) ──────────────────────────────────────────
# Set to your backend Render service URL + /api/v1 before building.
# Example:
# VITE_API_BASE_URL=https://sita-ocr-backend.onrender.com/api/v1
VITE_API_BASE_URL=

